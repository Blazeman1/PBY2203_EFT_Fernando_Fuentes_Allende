<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.bancoxyz</groupId>
    <artifactId>auth-server</artifactId>
    <version>1.0.0</version>
    <name>auth-server</name>
    <description>
        Servidor de autorizacion OAuth2.0 (Spring Authorization Server) del Banco XYZ. Emite
        tokens de acceso via el flujo client_credentials para la comunicacion servicio-a-servicio
        entre los 3 BFF y los microservicios, con un scope por microservicio protegido
        (cuentas.access, clientes.access, pagos.access). El login de cada canal (JWT
        web/movil, sesion ATM) es responsabilidad de cada BFF, no de este servidor, tal como se
        justifica en readme.md.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- spring-security-oauth2-authorization-server SOLO trae las clases del protocolo OAuth2
             (RegisteredClient, OAuth2AuthorizationServerConfigurer, etc.), pero NO trae un
             servidor web servlet ni la auto-configuracion de Spring Security que registra el bean
             prototype de HttpSecurity que SecurityFilterChain necesita como parametro -de ahi el
             error en runtime "No qualifying bean of type HttpSecurity available" que aparecia sin
             estas dos dependencias explicitas. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Spring Authorization Server: version gestionada por spring-boot-starter-parent
             (igual que spring-kafka en los demas modulos), sin fijarla a mano aqui. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>auth-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
